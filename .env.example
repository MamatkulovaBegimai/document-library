DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Продакшндо гана керек (Render'де HTTPS'тин доменин коюңуз):
# DJANGO_CSRF_TRUSTED_ORIGINS=https://document-library.onrender.com

# База: коюлбаса — жергиликтүү SQLite колдонулат.
# Продакшндо Render (же башка) PostgreSQL'дин connection string'ин коюңуз:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# STORAGE_PROVIDER: local | s3 | r2
STORAGE_PROVIDER=local

# S3 / Cloudflare R2 колдонгондо гана керек (requirements.txt'де django-storages, boto3 бар):
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=document-library
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_DOMAIN=   # R2'де публикалык домен орнотсоңуз гана (милдеттүү эмес)

# Email / сырсөздү калыбына келтирүү.
# Gmail колдонсоңуз: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=True.
# EMAIL_HOST_PASSWORD катары кадимки пароль эмес, Google App Password колдонулат.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=your-email@gmail.com
